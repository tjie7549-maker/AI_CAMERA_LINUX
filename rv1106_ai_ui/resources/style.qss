QWidget#root {
    background: #10151b;
    color: #f2f5f7;
    font-family: "Droid Sans Fallback";
    font-size: 17px;
}

QFrame#topBar,
QFrame#bottomBar,
QFrame#panel {
    background: #1a222c;
    border: 1px solid #344351;
    border-radius: 4px;
}

QLabel#mainTitle {
    color: #f7fafc;
    font-size: 24px;
    font-weight: 700;
}

QLabel#statusLabel,
QLabel#tcpValue {
    font-size: 16px;
    font-weight: 700;
}

QLabel#statusLabel[state="online"],
QLabel#tcpValue[state="online"] {
    color: #4bd197;
}

QLabel#statusLabel[state="waiting"],
QLabel#tcpValue[state="waiting"] {
    color: #f3b455;
}

QLabel#statusLabel[state="offline"],
QLabel#tcpValue[state="offline"] {
    color: #9aa8b5;
}

QLabel#statusLabel[state="warning"],
QLabel#tcpValue[state="warning"] {
    color: #ff6b6b;
}

QLabel#metaLabel,
QLabel#clockLabel {
    color: #aebbc6;
    font-size: 14px;
}

QLabel#clockLabel {
    color: #44c2d7;
}

QLabel#sectionTitle {
    color: #f2f5f7;
    font-size: 22px;
    font-weight: 700;
}

QFrame#previewFrame {
    background: #0b0f14;
    border: 1px solid #4b5c6a;
    border-radius: 2px;
}

QLabel#previewTitle {
    color: #d7e0e7;
    font-size: 24px;
    font-weight: 700;
}

QLabel#previewMessage {
    color: #7f909d;
    font-size: 17px;
}

QLabel#videoInfo {
    color: #44c2d7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#videoWaiting {
    color: #f3b455;
    font-size: 17px;
}

QPushButton#pauseButton,
QPushButton#recognizeButton {
    background: #226b85;
    border: 1px solid #44c2d7;
    border-radius: 4px;
    color: #f2f5f7;
    font-size: 24px;
    font-weight: 700;
}

QPushButton#pauseButton:pressed,
QPushButton#recognizeButton:pressed {
    background: #17495c;
    border-color: #9eeaf4;
}

QPushButton#pauseButton:checked {
    background: #a56722;
    border-color: #f3b455;
}

QPushButton#pauseButton:disabled,
QPushButton#recognizeButton:disabled {
    background: #3b4650;
    border-color: #596671;
    color: #87939d;
}

QLabel#fieldCaption,
QLabel#metricCaption {
    color: #81919f;
    font-size: 12px;
    font-weight: 700;
}

QLabel#fieldValue {
    color: #edf2f5;
    font-family: "Droid Sans Fallback";
    font-size: 17px;
}

QLabel#summaryValue {
    color: #cdd7de;
    font-family: "Droid Sans Fallback";
    font-size: 16px;
}

QLabel#alertValue {
    font-size: 18px;
    font-weight: 700;
}

QLabel#alertValue[state="normal"] {
    color: #4bd197;
}

QLabel#alertValue[state="warning"] {
    color: #ff6b6b;
}

QLabel#metricValue {
    color: #f2f5f7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#errorValue {
    color: #b9c5ce;
    font-family: "Droid Sans Fallback";
    font-size: 14px;
}
