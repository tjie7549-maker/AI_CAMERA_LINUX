#!/bin/sh

DAEMON=/root/userdata/ai_camera/run_rv1106_supervisor.sh
PIDFILE=/var/run/ai-camera.pid
PERSIST_ROOT=/userdata
LEGACY_ROOT=/root/userdata

prepare_userdata() {
    if grep -q " $LEGACY_ROOT " /proc/mounts 2>/dev/null; then
        return 0
    fi

    if [ ! -x "$PERSIST_ROOT/ai_camera/run_rv1106_supervisor.sh" ]; then
        echo "Copying ai-camera files to writable userdata..."
        cp -a "$LEGACY_ROOT/." "$PERSIST_ROOT/" || return 1
    fi

    mount --bind "$PERSIST_ROOT" "$LEGACY_ROOT" || return 1
}

start() {
    if ! prepare_userdata; then
        echo "Failed to prepare writable $LEGACY_ROOT"
        return 1
    fi
    if [ ! -x "$DAEMON" ]; then
        echo "ai-camera supervisor not found: $DAEMON"
        return 1
    fi
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
        echo "ai-camera already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "Starting ai-camera supervisor..."
    start-stop-daemon -S -q -m -b -p "$PIDFILE" -x "$DAEMON"
}

stop() {
    echo "Stopping ai-camera supervisor..."
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid"
        fi
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
            sleep 1
            i=$((i + 1))
        done
        rm -f "$PIDFILE"
    fi
    echo "ai-camera stopped"
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
        echo "ai-camera running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "ai-camera not running"
    return 1
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
