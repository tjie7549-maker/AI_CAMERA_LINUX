# Bind only to the private RV1106 <-> ROCK 2A Ethernet link by default.
AI_CAMERA_BIND_ADDRESS=192.168.50.1
AI_CAMERA_EVENT_PORT=9011
AI_CAMERA_MANUAL_PORT=9001
AI_CAMERA_RESULT_PORT=9000
AI_CAMERA_RV_HOST=rv1106-ai-camera
AI_CAMERA_RV_IP=192.168.50.2
AI_CAMERA_RTSP_PORT=554

# Conservative event-driven cloud policy.
EVENT_CLOUD_ENABLED=1
EVENT_INITIAL_DELAY_SECONDS=3
EVENT_CLOUD_COOLDOWN_SECONDS=120
EVENT_LONG_REFRESH_SECONDS=300
EVENT_SCENE_CHANGE_THRESHOLD=0.15
EVENT_END_GRACE_SECONDS=10
EVENT_DETECTION_STALE_SECONDS=5
EVENT_CLOUD_MAX_RETRIES=2

# Existing compatibility and storage controls.
AI_BACKEND=cloud
AI_CAMERA_MIN_FREE_MB=1024
AI_CAMERA_AUTO_SAVE_POLICY=warning
AI_CAMERA_AUTO_SAVE_DEDUP_SECONDS=60
