{
  "socket_path": "/userdata/rv1106-smart-camera/run/camera-daemon.sock",
  "log_path": "/userdata/rv1106-smart-camera/logs/events.jsonl",
  "sensor_subdev": "/dev/v4l-subdev2",
  "sender_path": "/userdata/rv1106-smart-camera/bin/media-sender",
  "bridge_path": "/userdata/rv1106-smart-camera/bin/rtsp-preview-bridge",
  "npu_path": "/userdata/npu_detect/npu_detect",
  "iq_dir": "/oem/usr/share/iqfiles",
  "isp_control_socket": "/tmp/rv1106_isp_control.sock",
  "rkipc_path": "/oem/usr/bin/rkipc",
  "rkipc_socket": "/var/tmp/rkipc",
  "rtsp_url": "rtsp://127.0.0.1/live/0",
  "backlight_control": true,
  "backlight_path": "/sys/class/backlight/backlight/bl_power",
  "backlight_idle_seconds": 30,
  "backlight_wake_hits": 3,
  "memory_watchdog_enabled": true,
  "memory_available_min_kb": 40960,
  "memory_low_checks": 3,
  "memory_check_interval_ms": 10000,
  "start_pipeline": true,
  "start_npu": true,
  "auto_ae": true
}
